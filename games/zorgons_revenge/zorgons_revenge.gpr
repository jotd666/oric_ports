with "../../runtime/runtime.gpr";

project zorgons_revenge is

for languages use ("C");

   for main use ("zorgon.c");
   
for source_dirs use ("src");
   for object_dir use "obj/" & runtime.hal;

   for exec_dir use ".";
   package compiler renames runtime.compiler;
   for Archive_Indexer use runtime'Archive_Indexer;
   
   package linker extends runtime.linker is
      case runtime.hal is
         when "sdl" =>
            for default_switches("c") use linker'default_switches("c") &("-lSDL_Image","-lSDL");
            when others =>
            end case;
   end linker;
   
end zorgons_revenge;
