library project runtime is

sdl_home := "";

   -- amiga: #ifdef __amigaos__
   -- windows: #ifdef _WIN32
   

   
type Build_Type is ("Debug","Release");
   Build : Build_Type := External("Build","Debug");
   type HalType is ("sdl","amiga");
   
   hal : HalType := External("hal","sdl");
   
   for languages use ("C");

   gcc_prefix := "";
   
   for source_dirs use ("src","src/" & hal);
   case hal is
      when "amiga" =>
         gcc_prefix := "m68k-amigaos-";
      when others =>          
         sdl_home := external("SDL_HOME","K:/progs/SDL/1.2/");
         for source_dirs use project'source_dirs & (sdl_home & "include");
   end case;
   
   -- always include sdl headers
    
  
   
   for object_dir use "obj/" & hal;
   for library_name use "oric";
   for library_kind use "static";
   for library_dir use "lib/" & hal;
   sdl_link_bin := sdl_home&"bin";
  sdl_link_base := ("-L" & sdl_link_bin);
   sdl_link := ();
                            
   package builder is
      for switches(others) use ("-k","-j2");
	  case hal is
         when "amiga" =>
            for Executable_Suffix use "";
         when others =>            
      end case;
   end builder;
   
   Base_Switches := ("-Wall","-W","-Werror","-Wno-stringop-overflow","-Wno-unused-label","-fmax-errors=50");
   
   for Archive_Indexer use (gcc_prefix & "ranlib");
   
   package compiler is
      for driver("C") use gcc_prefix & "gcc";
            case hal is
         when "amiga" =>
            when others =>
            Base_Switches := Base_Switches & ("-DHAS_SDL_IMAGE");
       end case;
   case Build is
      when "Debug" =>
         for default_switches("C") use Base_Switches & ("-O0","-g");
      when "Release" =>
         for default_switches("C") use Base_Switches & ("-O2","-DNDEBUG");
      end case;

   end compiler;

   
  

   package linker is
         for driver use gcc_prefix & "gcc";

  
         for linker_options use sdl_link_base & ("-L"&sdl_home&"lib/x86","-lSDL","-Wl,-s","-mwindows");

         
 end linker;
 
end runtime;
